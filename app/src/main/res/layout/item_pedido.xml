<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_blanca"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtFolioPedidoItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Pedido #TV-00001"
            android:textColor="@color/tv_texto_principal"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtEstadoPedidoItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_azul_suave"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="Pagado"
            android:textColor="@color/tv_azul_primario"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtFechaPedidoItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Fecha • Método"
        android:textColor="@color/tv_texto_secundario"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/txtDetallePedidoItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Artículos"
        android:textColor="@color/tv_texto_principal"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/txtTotalPedidoItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:text="$0.00 MXN"
        android:textColor="@color/tv_azul_primario"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
